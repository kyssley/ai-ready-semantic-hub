{
  "$defs": {
    "Column": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[a-z][a-z0-9_]{0,62}$",
          "title": "Name",
          "type": "string"
        },
        "label": {
          "default": "",
          "maxLength": 4000,
          "title": "Label",
          "type": "string"
        },
        "data_type": {
          "enum": [
            "string",
            "integer",
            "number",
            "date",
            "timestamp",
            "boolean"
          ],
          "title": "Data Type",
          "type": "string"
        },
        "description": {
          "default": "",
          "maxLength": 4000,
          "title": "Description",
          "type": "string"
        },
        "dimension": {
          "default": true,
          "title": "Dimension",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "data_type"
      ],
      "title": "Column",
      "type": "object"
    },
    "Filter": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "pattern": "^[a-z][a-z0-9_]{0,62}\\.[a-z][a-z0-9_]{0,62}$",
          "title": "Field",
          "type": "string"
        },
        "op": {
          "default": "eq",
          "enum": [
            "eq",
            "ne",
            "gt",
            "gte",
            "lt",
            "lte",
            "in",
            "is_null",
            "not_null"
          ],
          "title": "Op",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  }
                ]
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "field"
      ],
      "title": "Filter",
      "type": "object"
    },
    "Metric": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,62}$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "description": {
          "default": "",
          "maxLength": 4000,
          "title": "Description",
          "type": "string"
        },
        "owner": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Owner",
          "type": "string"
        },
        "tags": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]{0,62}$",
            "type": "string"
          },
          "maxItems": 30,
          "title": "Tags",
          "type": "array"
        },
        "synonyms": {
          "items": {
            "maxLength": 160,
            "type": "string"
          },
          "maxItems": 30,
          "title": "Synonyms",
          "type": "array"
        },
        "visibility": {
          "default": "public",
          "enum": [
            "public",
            "internal"
          ],
          "title": "Visibility",
          "type": "string"
        },
        "model": {
          "pattern": "^[a-z][a-z0-9_]{0,62}$",
          "title": "Model",
          "type": "string"
        },
        "aggregation": {
          "enum": [
            "sum",
            "count",
            "count_distinct",
            "avg",
            "min",
            "max",
            "ratio"
          ],
          "title": "Aggregation",
          "type": "string"
        },
        "column": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{0,62}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Column"
        },
        "denominator": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{0,62}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Denominator"
        },
        "unit": {
          "default": "number",
          "maxLength": 80,
          "title": "Unit",
          "type": "string"
        },
        "currency_dimension": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{0,62}\\.[a-z][a-z0-9_]{0,62}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency Dimension"
        },
        "time_dimension": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{0,62}\\.[a-z][a-z0-9_]{0,62}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time Dimension"
        },
        "filters": {
          "items": {
            "$ref": "#/$defs/Filter"
          },
          "maxItems": 20,
          "title": "Filters",
          "type": "array"
        },
        "business_rules": {
          "items": {
            "maxLength": 4000,
            "type": "string"
          },
          "maxItems": 20,
          "title": "Business Rules",
          "type": "array"
        }
      },
      "required": [
        "id",
        "label",
        "owner",
        "model",
        "aggregation"
      ],
      "title": "Metric",
      "type": "object"
    },
    "Model": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,62}$",
