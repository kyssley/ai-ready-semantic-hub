            "public",
            "internal"
          ],
          "title": "Visibility",
          "type": "string"
        },
        "table": {
          "maxLength": 190,
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){0,2}$",
          "title": "Table",
          "type": "string"
        },
        "primary_key": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]{0,62}$",
            "type": "string"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Primary Key",
          "type": "array"
        },
        "columns": {
          "items": {
            "$ref": "#/$defs/Column"
          },
          "maxItems": 200,
          "minItems": 1,
          "title": "Columns",
          "type": "array"
        }
